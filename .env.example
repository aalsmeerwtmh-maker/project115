# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit it.

# Your Tailscale IP (run `tailscale ip -4` to find it).
# Required for Metro to advertise the correct address to your Android device over Tailscale.
# Without this, the device will try to connect to the wrong IP and show a white screen.
REACT_NATIVE_PACKAGER_HOSTNAME=your.tailscale.ip.here
