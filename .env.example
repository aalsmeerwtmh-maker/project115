# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit it.

# Your Tailscale IP (run `tailscale ip -4` to find it).
# Required for Metro to advertise the correct address to your Android device over Tailscale.
# Without this, the device will try to connect to the wrong IP and show a white screen.
REACT_NATIVE_PACKAGER_HOSTNAME=your.tailscale.ip.here

# Google Maps Android API key.
# This is a BUILD-TIME value — it gets baked into the Android manifest.
# Setting it here only takes effect if you do a local prebuild.
# For EAS cloud builds, set it as an EAS secret instead:
#   eas env:create --name GOOGLE_MAPS_ANDROID_KEY --value <key> --scope project
# Then rebuild the dev client: eas build --profile development --platform android
GOOGLE_MAPS_ANDROID_KEY=your-google-maps-key-here
