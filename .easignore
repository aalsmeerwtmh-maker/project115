# Dependencies & VCS history — not needed for the build (huge)
node_modules/
.git/

# Native dirs are generated by CNG (gitignored). Exclude them so EAS prebuilds
# fresh and injects config from app.config.ts (e.g. the Maps API key meta-data).
# Leaving a stale local android/ here makes EAS build from it and DROP the key.
/android/
/ios/

# Raw 3D source material (Meshy exports). The build uses assets/ar/models/ only.
ui/

# Leftover build outputs (never build inputs)
*.apk
*.aab
*.apks
bundletool.jar

# Local exports / scratch & caches
transcript/
.expo/
dist/
web-build/
